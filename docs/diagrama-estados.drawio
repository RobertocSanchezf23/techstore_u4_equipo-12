        <mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;endSize=8;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" edge="1" source="s11" target="s14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;Transiciones no permitidas&lt;/b&gt;&lt;br/&gt;Cualquier operación que no aparece como flecha desde el estado actual lanza &lt;b&gt;InvalidOrderTransition&lt;/b&gt; (HTTP 409).&lt;br/&gt;Ejemplos: confirmar desde CONFIRMED (E12), cancelar desde SHIPPED (E13), agregar artículos fuera de DRAFT." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#fffde7;strokeColor=#b59f3b;" parent="1" vertex="1">
          <mxGeometry x="1200" y="395" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n26" value="&lt;b&gt;Condición que no se cumple&lt;/b&gt;&lt;br/&gt;Lanza &lt;b&gt;InvalidOrderData&lt;/b&gt; (HTTP 422): pedido vacío (E06), cliente inactivo (E03), envío sin guía (E11), cancelar sin motivo.&lt;br/&gt;&lt;b&gt;OrderItemLimitExceeded&lt;/b&gt; (HTTP 422): más de 20 unidades (E08)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#fffde7;strokeColor=#b59f3b;" parent="1" vertex="1">
          <mxGeometry x="1200" y="490" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n27" value="&lt;b&gt;Orden de cada transición&lt;/b&gt;&lt;br/&gt;1. validar estado y condiciones&lt;br/&gt;2. cambiar status&lt;br/&gt;3. registrar el Domain Event&lt;br/&gt;Si el paso 1 falla, el estado y la lista de eventos no cambian." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#fffde7;strokeColor=#b59f3b;" parent="1" vertex="1">
          <mxGeometry x="150" y="395" width="330" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n28" value="&lt;b&gt;DomainEvent&lt;/b&gt; (inmutable)&lt;br/&gt;name · order_id · customer_id&lt;br/&gt;total (Money) · detail (guía o motivo)&lt;br/&gt;occurred_at (UTC)" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#fffde7;strokeColor=#b59f3b;" parent="1" vertex="1">
          <mxGeometry x="150" y="495" width="330" height="74" as="geometry" />
