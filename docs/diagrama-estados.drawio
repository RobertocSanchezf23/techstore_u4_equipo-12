        <mxCell id="e15" value="load_fixture()&lt;br/&gt;Order(...)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;endSize=8;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" edge="1" source="s5" target="s6">
